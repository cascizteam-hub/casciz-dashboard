# ─────────────────────────────────────────────────────────────────────────────
# Casciz Commerce OS – Environment Variables Reference
# Copy this file to .env and fill in all values before running the project.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Compose project ──────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=casciz

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=casciz_commerce
POSTGRES_USER=casciz_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── Spring Boot ──────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=production
SERVER_PORT=8080

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_minimum_64_character_base64_secret_key_here
JWT_ACCESS_TOKEN_EXPIRY_MS=900000
JWT_REFRESH_TOKEN_EXPIRY_MS=604800000

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.casciz.com

# ── Frontend (Next.js public vars must start with NEXT_PUBLIC_) ──────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME=Casciz Commerce OS
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Internal Next.js server-side ─────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_minimum_32_character_nextauth_secret

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@casciz.com
MAIL_PASSWORD=CHANGE_ME_smtp_password
MAIL_FROM_NAME=Casciz Commerce OS

# ── File Storage (S3-compatible) ─────────────────────────────────────────────
STORAGE_PROVIDER=local
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=casciz-assets
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_REGION=us-east-1

# ── Monitoring ────────────────────────────────────────────────────────────────
ACTUATOR_BASE_PATH=/actuator
MANAGEMENT_ENDPOINTS_EXPOSE=health,info,metrics

# ── Encryption (for payment API keys stored at rest) ─────────────────────────
# Generate with: openssl rand -base64 32
CASCIZ_ENCRYPTION_SECRET=CHANGE_ME_32_character_encryption_secret
